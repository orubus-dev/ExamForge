# ──────────────────────────────────────────────────────────────────────────────
# ExamForge — environment variables
# Copy to .env.local for local dev, or set them in Cloudflare Pages / GitHub
# Actions (NEXT_PUBLIC_* must be present at BUILD time for `next-on-pages`).
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (client, safe to expose — protected by RLS) ──────────────────────
# Project URL, e.g. https://cbnrbgqgfsxhlugtrsxs.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Browser anon key (publishable)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (server-only — NEVER prefix with NEXT_PUBLIC) ────────────────────
# Service role key. Used only in API routes on the edge for admin tasks
# (creating users, PIN hashing support, grading, publishing). Never exposed.
SUPABASE_SERVICE_ROLE_KEY=

# ── Genjutsu OAuth 2.0 + PKCE (primary sign-in provider) ──────────────────────
# Client id registered at https://genjustu.pages.dev
# Redirect URIs registered there:
#   https://examforage.pages.dev/auth/genjutsu/callback
#   http://localhost:3000/auth/genjutsu/callback
GENJUTSU_CLIENT_ID=
GENJUTSU_CLIENT_SECRET=

# ── Relay OTP (secondary email-OTP sign-in provider) ──────────────────────────
RELAY_CLIENT_ID=
RELAY_CLIENT_SECRET=
# Auth-challenge function base. Default:
# https://gobwknacvpgysmgpvzqt.supabase.co/functions/v1/auth-challenge
RELAY_API_BASE=https://gobwknacvpgysmgpvzqt.supabase.co/functions/v1/auth-challenge
